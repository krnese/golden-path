{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "python3 \"${PLUGIN_ROOT}/scripts/gate.py\" start",
        "powershell": "python \"${PLUGIN_ROOT}/scripts/gate.py\" start",
        "timeoutSec": 15
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "bash": "python3 \"${PLUGIN_ROOT}/scripts/gate.py\" guard",
        "powershell": "python \"${PLUGIN_ROOT}/scripts/gate.py\" guard",
        "timeoutSec": 10
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "bash": "python3 \"${PLUGIN_ROOT}/scripts/gate.py\" stop",
        "powershell": "python \"${PLUGIN_ROOT}/scripts/gate.py\" stop",
        "timeoutSec": 120
      }
    ],
    "subagentStart": [
      {
        "type": "command",
        "matcher": "golden-path-reviewer",
        "bash": "python3 \"${PLUGIN_ROOT}/scripts/gate.py\" subagent start",
        "powershell": "python \"${PLUGIN_ROOT}/scripts/gate.py\" subagent start",
        "timeoutSec": 10
      }
    ],
    "subagentStop": [
      {
        "type": "command",
        "bash": "python3 \"${PLUGIN_ROOT}/scripts/gate.py\" subagent stop",
        "powershell": "python \"${PLUGIN_ROOT}/scripts/gate.py\" subagent stop",
        "timeoutSec": 10
      }
    ]
  }
}
