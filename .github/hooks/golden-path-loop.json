{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "node \".github/hooks/golden-path/gate.mjs\" start",
        "powershell": "node \".github/hooks/golden-path/gate.mjs\" start",
        "timeoutSec": 15
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "bash": "node \".github/hooks/golden-path/gate.mjs\" guard",
        "powershell": "node \".github/hooks/golden-path/gate.mjs\" guard",
        "timeoutSec": 10
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "bash": "node \".github/hooks/golden-path/gate.mjs\" stop",
        "powershell": "node \".github/hooks/golden-path/gate.mjs\" stop",
        "timeoutSec": 120
      }
    ],
    "subagentStart": [
      {
        "type": "command",
        "matcher": "golden-path-reviewer",
        "bash": "node \".github/hooks/golden-path/gate.mjs\" subagent start",
        "powershell": "node \".github/hooks/golden-path/gate.mjs\" subagent start",
        "timeoutSec": 10
      }
    ],
    "subagentStop": [
      {
        "type": "command",
        "bash": "node \".github/hooks/golden-path/gate.mjs\" subagent stop",
        "powershell": "node \".github/hooks/golden-path/gate.mjs\" subagent stop",
        "timeoutSec": 10
      }
    ]
  }
}
